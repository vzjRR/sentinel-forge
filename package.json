{
  "name": "sentinel-forge",
  "version": "0.3.0",
  "private": true,
  "description": "Sentinel Forge \u2014 FiveM Server Intelligence. Local-first diagnostic intelligence for FiveM/GTA V server environments.",
  "author": "Talal Al Ghafri",
  "contributors": [
    "vzjRR (developer)"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/lua",
    "packages/core",
    "packages/scanner",
    "packages/dependencies",
    "packages/analyzer",
    "packages/engine",
    "packages/reports",
    "apps/cli"
  ],
  "scripts": {
    "build": "node scripts/generate-migrations.mjs && tsc --build tsconfig.json",
    "build:clean": "tsc --build tsconfig.json --clean",
    "typecheck": "tsc --build tsconfig.json --force && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:performance": "vitest run --project performance",
    "verify": "npm run check:versions && npm run check:migrations && npm run lint && npm run typecheck && npm run test && npm run build",
    "sentinel": "node apps/cli/dist/bin/sentinel.js",
    "generate:migrations": "node scripts/generate-migrations.mjs",
    "check:migrations": "node scripts/generate-migrations.mjs --check",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
