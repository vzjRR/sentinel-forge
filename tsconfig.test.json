{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@sentinel-forge/shared": [
        "packages/shared/src/index.ts"
      ],
      "@sentinel-forge/lua": [
        "packages/lua/src/index.ts"
      ],
      "@sentinel-forge/core": [
        "packages/core/src/index.ts"
      ],
      "@sentinel-forge/scanner": [
        "packages/scanner/src/index.ts"
      ],
      "@sentinel-forge/dependencies": [
        "packages/dependencies/src/index.ts"
      ],
      "@sentinel-forge/analyzer": [
        "packages/analyzer/src/index.ts"
      ],
      "@sentinel-forge/performance": [
        "packages/performance/src/index.ts"
      ],
      "@sentinel-forge/incidents": [
        "packages/incidents/src/index.ts"
      ],
      "@sentinel-forge/security": [
        "packages/security/src/index.ts"
      ],
      "@sentinel-forge/integrity": [
        "packages/integrity/src/index.ts"
      ],
      "@sentinel-forge/engine": [
        "packages/engine/src/index.ts"
      ],
      "@sentinel-forge/reports": [
        "packages/reports/src/index.ts"
      ],
      "@sentinel-forge/cli": [
        "apps/cli/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
